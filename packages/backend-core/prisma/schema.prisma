// Prisma schema for backend-core library
// Uses AC_CORE_DATABASE_URL environment variable

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ========== Better Auth Models ==========
model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // 'user' | 'admin'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      account[]
  sessions      session[]
}

model session {
  id        String   @id
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model account {
  id                    String    @id
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ========== EnvHopper Models ==========

enum ApprovalMethodType {
  service
  personTeam
  custom
  noAccessRequired
  unknown
}

// ========== Person & Group Models ==========

model DbPerson {
  slug        String              @id // email or synthetic
  firstName   String
  lastName    String
  email       String?             @unique
  memberships DbGroupMembership[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model DbGroup {
  slug        String              @id
  displayName String?
  email       String? // team alias
  memberships DbGroupMembership[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model DbGroupMembership {
  id         Int      @id @default(autoincrement())
  groupSlug  String
  group      DbGroup  @relation(fields: [groupSlug], references: [slug], onDelete: Cascade)
  personSlug String
  person     DbPerson @relation(fields: [personSlug], references: [slug], onDelete: Cascade)

  @@unique([groupSlug, personSlug])
}

model DbApprovalMethod {
  slug              String             @id
  type              ApprovalMethodType
  displayName       String
  /// [ApprovalMethodConfig] - Type-specific configuration
  config            Json?
  deprecatedAliases String[]           @default([]) // Old URLs that should redirect to this method
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([type, displayName])
}

model DbResource {
  id                         String            @id @default(cuid())
  slug                       String            @unique // URL-friendly identifier for navigation
  type                       String            @default("application") // "application" | "sub-resource" | etc.
  displayName                String
  abbreviation               String? // Optional short abbreviation (e.g. K8s, ECR, LV)
  nicknames                  String[]          @default([]) // Alternative names / AKA
  description                String
  /// [AccessMethod]
  access                     Json?
  teams                      String[]          @default([])
  /// [AccessRequest] - Per-resource approval configuration linking to ApprovalMethod
  accessRequest              Json?
  notes                      String?
  tags                       String[]          @default([])
  appUrl                     String?
  /// [AppLink[]]
  links                      Json? // Array of {displayName?: string, url: string}
  iconName                   String? // Optional icon identifier matching DbAsset.name
  screenshotIds              String[]          @default([]) // Ordered array of DbAsset IDs
  /// [AppDeprecation] - Deprecation info with optional replacement slug
  deprecated                 Json?
  aiPrompt                   String?
  aiMemory                   String?
  urlIssues                  String[]          @default([])
  /// [TierVariant[]]
  tiers                      Json?
  sourceRefs                 SourceReference[]
  comments                   DbComment[]
  // Self-referential tree: sub-resources point to their parent
  parentSlug                 String?
  parent                     DbResource?       @relation("ResourceTree", fields: [parentSlug], references: [slug])
  children                   DbResource[]      @relation("ResourceTree")
  // Fields merged from former DbSubResource
  tier                       String? // e.g. "prod", "dev"
  aliases                    String[]          @default([])
  ownerPersonSlug            String?
  approverSlugs              String[]          @default([]) // Person or Group slugs

  accessComments             String?
  /// [SubResourceExtra]
  extra                      Json?
  // Freshness (autoupdate scan): when sources were last verified, when the next
  // check is due, and when the source content last actually changed (what the UI
  // shows as "Updated" — a source can be re-read without changing).
  // Nullable — apps that have never been scanned carry null.
  lastCheckedAt              DateTime?
  nextCheckAfter             DateTime?
  lastContentChangeAt        DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([displayName])
  @@index([slug])
  @@index([tags])
  @@index([parentSlug])
}

/// A visitor's comment on one resource.
///
/// The catalog is browsable without logging in, so a comment carries no user id.
/// Instead the server issues an opaque visitor token in an httpOnly cookie and
/// stores its hash: enough to let an author edit or delete their own comment for
/// a short window, and nothing a reader can forge.
model DbComment {
  id         String     @id @default(cuid())
  // The resource's id, not its slug — a slug is user-facing and gets renamed.
  resourceId String
  resource   DbResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  // sha256 of the visitor token. Authorises edit/delete; never sent to a client.
  authorHash String
  // The pseudonym shown next to the comment, stored rather than derived at render
  // time so editing the wordlist later cannot rename everybody's history.
  authorAlias String
  body        String
  // Set on a later edit, so the UI can mark a comment as edited. Null when never edited.
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([resourceId, createdAt])
  @@index([authorHash])
}

model DbAppTagDefinition {
  id          String   @id @default(cuid())
  prefix      String   @unique
  displayName String
  description String
  /// [GroupingTagValue[]]
  values      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AssetType {
  icon
  screenshot
}

model DbAsset {
  id        String    @id @default(cuid())
  name      String    @unique // Name with extension (e.g., "jira.svg", "github.png")
  assetType AssetType @default(icon)
  content   Bytes // Binary storage for all asset types (SVG, PNG, etc)
  checksum  String // SHA-256 of content for deduplication
  mimeType  String // e.g., "image/svg+xml", "image/png", "image/jpeg"
  fileSize  Int // Size in bytes
  width     Int? // Image width in pixels
  height    Int? // Image height in pixels
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([assetType])
}

model Source {
  slug       String            @id
  userPrompt String?
  references SourceReference[]
}

model SourceReference {
  id         Int        @id @default(autoincrement())
  sourceSlug String
  source     Source     @relation(fields: [sourceSlug], references: [slug], onDelete: Cascade)
  resourceId String
  resource   DbResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  url        String
  parseDate  DateTime?
  excerpts   String[]   @default([])
  userPrompt String?

  @@unique([resourceId, url])
}
