// Prisma schema for backend-core library
// Uses AC_CORE_DATABASE_URL environment variable

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ========== Better Auth Models ==========
model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // 'user' | 'admin'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      account[]
  sessions      session[]
}

model session {
  id        String   @id
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model account {
  id                    String    @id
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ========== EnvHopper Models ==========

enum ApprovalMethodType {
  service
  personTeam
  custom
  noAccessRequired
  unknown
}

// ========== Person & Group Models ==========

model DbPerson {
  slug        String              @id // email or synthetic
  firstName   String
  lastName    String
  email       String?             @unique
  memberships DbGroupMembership[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model DbGroup {
  slug        String              @id
  displayName String?
  email       String? // team alias
  memberships DbGroupMembership[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model DbGroupMembership {
  id         Int      @id @default(autoincrement())
  groupSlug  String
  group      DbGroup  @relation(fields: [groupSlug], references: [slug], onDelete: Cascade)
  personSlug String
  person     DbPerson @relation(fields: [personSlug], references: [slug], onDelete: Cascade)

  @@unique([groupSlug, personSlug])
}

model DbApprovalMethod {
  slug              String             @id
  type              ApprovalMethodType
  displayName       String
  shortName         String? // One or two words for tight spots (the detail card's access tab); falls back to displayName
  /// [ApprovalMethodConfig] - Type-specific configuration
  config            Json?
  deprecatedAliases String[]           @default([]) // Old URLs that should redirect to this method
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([type, displayName])
}

model DbResource {
  id                         String            @id @default(cuid())
  slug                       String            @unique // URL-friendly identifier for navigation
  type                       String            @default("application") // "application" | "sub-resource" | etc.
  displayName                String
  abbreviation               String? // Optional short abbreviation (e.g. K8s, ECR, LV)
  nicknames                  String[]          @default([]) // Alternative names / AKA
  description                String
  /// [AccessMethod]
  access                     Json?
  teams                      String[]          @default([])
  /// [AccessRequest] - Per-resource approval configuration linking to ApprovalMethod
  accessRequest              Json?
  notes                      String?
  // Historical context: when and why the app was built, and for whom. Context a
  // reader may want after the instructions, never instead of them.
  background                 String?
  tags                       String[]          @default([])
  appUrl                     String?
  /// [AppLink[]]
  links                      Json? // Array of {displayName?: string, url: string}
  iconName                   String? // Optional icon identifier matching DbAsset.name
  screenshotIds              String[]          @default([]) // Ordered array of DbAsset IDs
  /// [AppDeprecation] - Deprecation info with optional replacement slug
  deprecated                 Json?
  aiPrompt                   String?
  aiMemory                   String?
  urlIssues                  String[]          @default([])
  /// [TierVariant[]]
  tiers                      Json?
  /// [QuickJump[]]
  quickJumps                 Json?
  childrenLabel              String? // Plural noun for this resource's children ("Accounts"); set on the parent, names its tab
  sourceRefs                 SourceReference[]
  feedback                   DbFeedback[]
  // Self-referential tree: sub-resources point to their parent
  parentSlug                 String?
  parent                     DbResource?       @relation("ResourceTree", fields: [parentSlug], references: [slug])
  children                   DbResource[]      @relation("ResourceTree")
  // Fields merged from former DbSubResource
  tier                       String? // e.g. "prod", "dev"
  aliases                    String[]          @default([])
  ownerPersonSlug            String?
  approverSlugs              String[]          @default([]) // Person or Group slugs

  accessComments             String?
  /// [SubResourceExtra]
  extra                      Json?
  // Freshness (autoupdate scan): when sources were last verified, when the next
  // check is due, and when the source content last actually changed (what the UI
  // shows as "Updated" — a source can be re-read without changing).
  // Nullable — apps that have never been scanned carry null.
  lastCheckedAt              DateTime?
  nextCheckAfter             DateTime?
  lastContentChangeAt        DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([displayName])
  @@index([slug])
  @@index([tags])
  @@index([parentSlug])
}

/// What came of a comment once a maintainer read it.
enum CommentStatus {
  /// The comment improved the catalog — the entry now carries what it said.
  applied
  /// Read, entry left as it was.
  acknowledged
}

/// One piece of visitor input about the catalog: a note, a correction, or an ask for
/// something that is not in the catalog yet.
///
/// Browsable without logging in, so this carries no user id. The server issues an
/// opaque visitor token in an httpOnly cookie and stores its hash: enough to let an
/// author edit or withdraw their own, and nothing a reader can forge.
///
/// There is deliberately no `kind` discriminator. "Is anyone waiting on this" is
/// `status IS NULL`, and "is this about an entry or about the catalog" is whether
/// `resourceId` is set — so an enum would encode nothing the row does not already say,
/// and asking a visitor to classify their own report costs more than it buys.
model DbFeedback {
  id String @id @default(cuid())

  /// Null for a catalog-level ask ("please add X") — there is no entry to hang it on.
  /// The resource's id, not its slug: a slug is user-facing and gets renamed.
  resourceId String?
  resource   DbResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// What the visitor was looking for when nothing matched. Set only when resourceId is
  /// null — it is the whole substance of a new-app ask, and the thing we research.
  subject String?

  /// sha256 of the visitor token. Authorises edit/withdraw; never sent to a client.
  authorHash String
  /// The pseudonym shown alongside, stored rather than derived at render time so
  /// widening the wordlist later cannot rename everybody's history.
  authorAlias String

  /// Optional: a bare flag with no words is a valid signal, and the cheapest one a
  /// passing visitor can send.
  body String?

  attachments DbFeedbackAttachment[]

  /// Set on a later edit, so the UI can mark it edited. Null when never edited.
  editedAt DateTime?

  /// What a maintainer did with it. Null until reviewed — which is also what "open"
  /// means, so pending needs no stored value. Written out of band by review tooling,
  /// never by a visitor.
  status        CommentStatus?
  reviewerReply String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId, createdAt])
  @@index([authorHash])
  /// Drives the unreviewed counts on both surfaces: open items, newest first.
  @@index([status, createdAt])
}

/// An image attached to one piece of feedback.
///
/// Deliberately not a DbAsset: that model's `name` is `@unique` and that namespace holds
/// published, reviewed assets, so an unreviewed stranger's upload must not be able to
/// squat `jira.svg`. Promoting an attached logo into a real icon is an explicit
/// maintainer step through the existing upsertAsset.
model DbFeedbackAttachment {
  id String @id @default(cuid())

  /// Null between upload and submit: an image is stored before the feedback row exists,
  /// so abandoning the form leaves an orphan image rather than half-written feedback.
  /// A sweep deletes orphans older than a day.
  feedbackId String?
  feedback   DbFeedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  /// Who uploaded it, so submitting can only claim your OWN unclaimed images. Without
  /// this, `feedbackId` being a single FK means attaching a guessed id would MOVE that
  /// image off somebody else's feedback.
  authorHash String

  /// Re-encoded by sharp before storage, so this is always one of our own formats and
  /// never whatever bytes arrived.
  content  Bytes
  mimeType String
  fileSize Int
  checksum String
  width    Int?
  height   Int?
  /// The uploader's filename, shown to a maintainer. Never used as a path or a key.
  originalFilename String

  createdAt DateTime @default(now())

  @@index([feedbackId])
  @@index([authorHash, createdAt])
}

model DbAppTagDefinition {
  id          String   @id @default(cuid())
  prefix      String   @unique
  displayName String
  description String
  /// [GroupingTagValue[]]
  values      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AssetType {
  icon
  screenshot
}

model DbAsset {
  id        String    @id @default(cuid())
  name      String    @unique // Name with extension (e.g., "jira.svg", "github.png")
  assetType AssetType @default(icon)
  content   Bytes // Binary storage for all asset types (SVG, PNG, etc)
  checksum  String // SHA-256 of content for deduplication
  mimeType  String // e.g., "image/svg+xml", "image/png", "image/jpeg"
  fileSize  Int // Size in bytes
  width     Int? // Image width in pixels
  height    Int? // Image height in pixels
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([assetType])
}

model Source {
  slug       String            @id
  userPrompt String?
  references SourceReference[]
}

model SourceReference {
  id         Int        @id @default(autoincrement())
  sourceSlug String
  source     Source     @relation(fields: [sourceSlug], references: [slug], onDelete: Cascade)
  resourceId String
  resource   DbResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  url        String
  parseDate  DateTime?
  excerpts   String[]   @default([])
  userPrompt String?

  // Per-source schedule from the autoupdate loop — the same three dates
  // DbResource carries for the whole entry, plus what only a source has: its own
  // adaptive interval and its own recent check results. Drives the pulse mark.
  lastCheckedAt       DateTime?
  nextCheckAfter      DateTime?
  lastContentChangeAt DateTime?
  checkIntervalHours  Int?
  /// Newest-first [{date, changed}], capped by the producer.
  changeHistory       Json?

  @@unique([resourceId, url])
}
