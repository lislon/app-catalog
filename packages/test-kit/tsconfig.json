{
  "extends": "../../tsconfig.json",
  "include": ["src", "tests", "*.config.ts", "*.config.js", "package.json"],
  "exclude": ["eslint.config.ts", "root-symlink.eslint.config.js"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest"],
    // Type-check against frontend-core's built .d.ts, not its sources: source
    // resolution drags in that package's own `~/*` paths and duplicate React
    // types. Same reason the downstream frontend does it.
    "customConditions": [],
    "outDir": "./dist-ts",
    "rootDir": "."
  }
}
