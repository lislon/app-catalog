{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "parallel": 2,
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/eslint.config.js"
    ],
    "default": [
      "sharedGlobals",
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/eslint.config.js"
    ]
  },
  "neverConnectToCloud": true,
  "targetDefaults": {
    "prisma:generate": {
      "cache": true,
      // Keyed and output by workspace path, because the generated client belongs to
      // backend-core wherever the target runs from. Only backend-core declares this
      // target: a second project generating the same client into the same directory
      // means two cache entries owning one output, which silently restored a stale
      // client over a fresh one, and made the generator append its imports twice
      // until the bundle would not parse.
      "inputs": [
        "{workspaceRoot}/packages/backend-core/prisma/schema.prisma",
        "{workspaceRoot}/package.json"
      ],
      "outputs": ["{workspaceRoot}/packages/backend-core/src/generated"]
    },
    "compile": {
      "cache": true,
      "dependsOn": ["prisma:generate", "^prisma:generate"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist-ts"]
    },
    "fix": {
      "dependsOn": ["^compile"],
      "inputs": ["default", "^production", "{workspaceRoot}/eslint.config.js"]
    },
    "test:eslint": {
      "cache": true,
      "dependsOn": ["^compile"],
      "inputs": ["default", "^production", "{workspaceRoot}/eslint.config.js"]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": ["^compile"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:types": {
      "cache": true,
      "dependsOn": ["^compile"],
      "inputs": ["default", "^production"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["prisma:generate", "^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/build", "{projectRoot}/dist"]
    },
    "test:build": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["production"]
    }
  }
}
